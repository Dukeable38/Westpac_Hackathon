# Copy to .env and fill in ONE provider block. .env is gitignored, so never commit real keys.
# After changing, run:  python scripts/llm_smoke.py

# --- Offline / tests (default) ---
LLM_PROVIDER=fake

# --- OpenRouter: the team's chosen route (17 Nov 2026). One key, many models; ---
# --- switch models by changing LLM_MODEL only. Model ids look like vendor/model, ---
# --- e.g. from https://openrouter.ai/models. Free variants end in :free (rate-limited). ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=<vendor/model id>

# --- Claude (direct) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5

# --- Google Gemini (OpenAI-compatible endpoint) ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=
# LLM_MODEL=<a current Gemini model id>

# --- NVIDIA NIM (build.nvidia.com) ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=
# LLM_MODEL=<model id from build.nvidia.com>

# --- Local (Ollama) ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=<local model name>

# --- Optional web search for research checks (otherwise they report "search not configured") ---
# SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=

# --- Demo behaviour ---
# DEMO_MODE=live | record | replay
DEMO_MODE=replay
DEMO_DELAY_MS=300
